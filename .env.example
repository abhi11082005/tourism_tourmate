# ---- Database -------------------------------------------------------------
DATABASE_URL=postgresql://tourmate:tourmate@localhost:5432/tourmate
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=5000

# ---- Redis (seat locks) ---------------------------------------------------
REDIS_URL=redis://localhost:6379
SEAT_HOLD_TTL_SECONDS=600

# ---- Auth -----------------------------------------------------------------
# Generate a real one: openssl rand -base64 48
# Minimum 24 characters, and production refuses to boot on a "change-me-*" value.
JWT_SECRET=change-me-before-you-deploy-anywhere
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---- Routing --------------------------------------------------------------
# Easiest start: the public OSRM demo server. It is rate-limited, must not be
# used in production, and answers with car data whatever profile you ask for —
# so pair it with OSRM_PROFILE=car.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=car

# Self-hosted (docker compose --profile routing up -d osrm) after the one-off
# preprocessing pass documented at the top of docker-compose.yml:
# OSRM_BASE_URL=http://localhost:5000
# OSRM_PROFILE=foot

# ---- AI assistant (RAG) ---------------------------------------------------
# Answer generation. Free-tier options: Groq (llama-3.1-8b-instant) or Google AI
# Studio (gemini-flash). Leave LLM_PROVIDER=none and the assistant returns a
# clean 503 instead of failing at boot — everything else still works.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Retrieval embeddings. Default is a local Ollama (`ollama pull nomic-embed-text`),
# which is free and needs no key. EMBEDDING_DIM must equal the vector(N) width in
# db/migrations/0001_init.sql — change both together.
EMBEDDING_URL=http://localhost:11434/api/embeddings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Payments -------------------------------------------------------------
# Both halves come from the Razorpay dashboard (Settings -> API Keys). Test-mode
# keys start with rzp_test_ and move no real money; the server refuses to boot in
# production with one. Leave both blank and the app still runs — checkout simply
# reports that payments are not configured.
#
# The key id is public and is handed to the checkout script. The SECRET verifies
# the callback HMAC and must never reach the browser or a log line.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# ISO-4217, three letters. Must match the currency your Razorpay account settles in.
PAYMENT_CURRENCY=INR

# ---- Client ---------------------------------------------------------------
# Vite variables do NOT belong in this file — the browser bundle reads
# client/.env instead. See client/.env.example.
