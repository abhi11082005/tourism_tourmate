# Where the Express API lives. Leave unset in development: vite.config.js proxies
# /api to http://localhost:4000, which avoids a CORS preflight on every seat poll.
# VITE_API_BASE_URL=https://api.tourmate.example/api

# Google Maps JavaScript API — the browser key. It is public by design (it is visible
# in the page source of every Google Maps site), so what protects it is the
# restriction you set in Google Cloud Console:
#   - Application restriction: HTTP referrers (http://localhost:5173/*, https://your-domain/*)
#   - API restriction: "Maps JavaScript API" only
# It is a DIFFERENT key from the server's GOOGLE_MAPS_SERVER_API_KEY (server/root .env),
# which must never be placed here. Without it the map area shows a clear "not
# configured" message; everything else on the site keeps working.
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_KEY

# Optional. AdvancedMarkerElement needs a Map ID. Leave blank to use Google's
# DEMO_MAP_ID (fine for development); create your own Vector Map ID in
# Cloud Console -> Map Management for production.
# VITE_GOOGLE_MAPS_MAP_ID=

# No payment key belongs in the browser bundle. The server hands the publishable
# key id to the checkout script at order time (POST /api/bookings/:id/order), so
# there is exactly one place to rotate it: server/.env.
