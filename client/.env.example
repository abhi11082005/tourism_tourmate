# Where the Express API lives. Leave unset in development: vite.config.js proxies
# /api to http://localhost:4000, which avoids a CORS preflight on every seat poll.
# VITE_API_BASE_URL=https://api.tourmate.example/api

# The map needs no key at all. MapLibre GL renders OpenFreeMap's OpenStreetMap
# tiles — no signup, no rate limit, no per-load billing. Both variables below are
# optional overrides; leave them blank to use the built-in OpenFreeMap styles.
#
# Any MapLibre-compatible style JSON URL works, including a self-hosted one.
# VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# No payment key belongs in the browser bundle. The server hands the publishable
# key id to the checkout script at order time (POST /api/bookings/:id/order), so
# there is exactly one place to rotate it: server/.env.
